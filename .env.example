# Export variables in your shell. This file is a reference, not auto-loaded.
PORT=8090
# TRIP_DATA_DIR=/absolute/path/to/private/trips
# Set both to enable HTTP Basic authentication. Do not commit real values.
# TRIP_USER=
# TRIP_PASS=
# Online maps and routing send locations to third-party services (see README).
TRIP_NETWORK=0
# Optional Google basemap: browser-visible key restricted to your local origins and Maps JavaScript API.
# GOOGLE_MAPS_BROWSER_KEY=
# Optional Google Places API (New): separate server-only key, restricted to Places API.
# GOOGLE_PLACES_API_KEY=
# New is the default; legacy supports existing projects with the older Places API.
GOOGLE_PLACES_API_MODE=new
